<mujoco model="v2_4">
  <compiler angle="radian"/>
  <!-- <option solver="PGS" timestep="0.001" /> -->
  
  <default>
    <geom density="1000"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3"
      rgb2=".2 .3 .4" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance=".2"/>

    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="LF_Thigh" file="LF_Thigh.STL"/>
    <mesh name="LF_Calf" file="LF_Calf.STL"/>
    <mesh name="RF_Thigh" file="RF_Thigh.STL"/>
    <mesh name="RF_Calf" file="RF_Calf.STL"/>
    <mesh name="LB_Thigh" file="LB_Thigh.STL"/>
    <mesh name="LB_Calf" file="LB_Calf.STL"/>
    <mesh name="RB_Thigh" file="RB_Thigh.STL"/>
    <mesh name="RB_Calf" file="RB_Calf.STL"/>
    <mesh name="LF_MAA_UPLink" file="LF_MAA_UPLink.STL"/>
    <mesh name="LF_MAA_FM_Link" file="LF_MAA_FM_Link.STL"/>
    <mesh name="LF_MAA_LOLink" file="LF_MAA_LOLink.STL"/>
    <mesh name="RF_MAA_UPLink" file="RF_MAA_UPLink.STL"/>
    <mesh name="RF_MAA_FM_Link" file="RF_MAA_FM_Link.STL"/>
    <mesh name="RF_MAA_LOLink" file="RF_MAA_LOLink.STL"/>
    <mesh name="LB_MAA_UPLink" file="LB_MAA_UPLink.STL"/>
    <mesh name="LB_MAA_FM_Link" file="LB_MAA_FM_Link.STL"/>
    <mesh name="LB_MAA_LOLink" file="LB_MAA_LOLink.STL"/>
    <mesh name="RB_MAA_UPLink" file="RB_MAA_UPLink.STL"/>
    <mesh name="RB_MAA_FM_Link" file="RB_MAA_FM_Link.STL"/>
    <mesh name="RB_MAA_LOLink" file="RB_MAA_LOLink.STL"/>
    <mesh name="LF_BAA_UPLink" file="LF_BAA_UPLink.STL"/>
    <mesh name="LF_BAA_FM_Link" file="LF_BAA_FM_Link.STL"/>
    <mesh name="LF_BAA_LOLink" file="LF_BAA_LOLink.STL"/>
    <mesh name="RF_BAA_UPLink" file="RF_BAA_UPLink.STL"/>
    <mesh name="RF_BAA_FM_Link" file="RF_BAA_FM_Link.STL"/>
    <mesh name="RF_BAA_LOLink" file="RF_BAA_LOLink.STL"/>
    <mesh name="LB_BAA_UPLink" file="LB_BAA_UPLink.STL"/>
    <mesh name="LB_BAA_FM_Link" file="LB_BAA_FM_Link.STL"/>
    <mesh name="LB_BAA_LOLink" file="LB_BAA_LOLink.STL"/>
    <mesh name="RB_BAA_UPLink" file="RB_BAA_UPLink.STL"/>
    <mesh name="RB_BAA_FM_LINK" file="RB_BAA_FM_LINK.STL"/>
    <mesh name="RB_BAA_LOLink" file="RB_BAA_LOLink.STL"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 10"/>
    <body name="base" pos="0 0 0">
      <geom size="10 10 .01" type="plane" material="grid"/>
      <body name="base box" pos="0 0 1">
        <geom type="box" size="0.1 0.1 0.1" rgba="0 1 0 1"/>
        <!-- <freejoint/> -->
        <body name="floating mass" pos="0 0 2">
          <geom type="box" size="0.1 0.1 0.1" rgba="1 0 0 1"/>
          <joint name="j1" type="slide" axis="0 0 1" damping="10" stiffness="200" springref="0"/>
          <body name="end box" pos="0 0 2"> 
            <geom type="box" size="0.1 0.1 0.1" rgba="0 1 0 1"/>
            <joint name="j2" type="slide" axis="0 0 1" damping="10" stiffness="200" springref="0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- 增加在RB_BAA_LowerJoint等关节中加入8个位置控制器，要求增加位置限制 -->
  <actuator>
    <!-- <position joint="LF_Shoulder" ctrlrange="-1 1" kp="30" kv="0.1"/>
    <position joint="LF_Elbow" ctrlrange="-1 1" kp="30" kv="0.1"/>
    <position joint="RF_Shoulder" ctrlrange="-1 1" kp="30" kv="0.1"/>
    <position joint="RF_Elbow" ctrlrange="-1 1" kp="30" kv="0.1"/>
    <position joint="LB_Shoulder" ctrlrange="-1 1" kp="30" kv="0.1"/>
    <position joint="LB_Elbow" ctrlrange="-1 1" kp="30" kv="0.1"/>
    <position joint="RB_Shoulder" ctrlrange="-1 1" kp="30" kv="0.1"/>
    <position joint="RB_Elbow" ctrlrange="-1 1" kp="30" kv="0.1"/> -->

    <general joint="j1" ctrllimited="true" ctrlrange="-156 156" />
    <general joint="j2" ctrllimited="true" ctrlrange="-78 78" />

  </actuator>

  <!-- 建立并联关系，如 RB_BAA_LOLink 应该与 RB_Calf 连接 --> 
  <equality>
    <!-- <connect name="RB_BAA_LOLink" body1="RB_BAA_LOLink" body2="RB_Calf" anchor="0 0 0" solref="0.001 1" solimp="0.5 0.995 0.00001"/>
    <connect name="RB_MAA_LOLink" body1="RB_MAA_LOLink" body2="RB_Thigh" anchor="0 0 0" solref="0.001 1" solimp="0.5 0.995 0.00001"/> -->

    <!-- FM 的相等约束 -->
    <!-- <joint name="12" joint1="j1" joint2="j2" solref="0.001 1" solimp="0.5 0.995 0.00001" polycoef="0 1 0 0 0"/> -->
    <!-- <joint name="RB_BAA_FM" joint1="RB_BAA_SlideJoint" joint2="RB_BAA_FM_SlideJoint" solref="0.001 1" solimp="0.5 0.995 0.00001" polycoef="0 1 0 0 0"/> -->
  </equality>

  <!-- sensor -->
  <sensor>
    <!-- <jointpos joint="LB_Shoulder" /> -->
    <!-- <jointvel joint="LB_Shoulder" /> -->
    <!-- <jointpos joint="LB_Elbow" /> -->
    <!-- <jointvel joint="LB_Elbow" /> -->
  </sensor>

</mujoco>
