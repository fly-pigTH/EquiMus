<mujoco model="v2_4">
  <compiler angle="radian"/>
  <option timestep="0.001" iterations="1000"/>
  
  <default>
    <geom density="418"/>
    <!-- <equality solimp="0.015 1 0.03" solref="0.005 1"/> -->
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3"
      rgb2=".2 .3 .4" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance=".2"/>

    <!-- <mesh name="base_link" file="base_link.STL"/> -->
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="LF_Thigh" file="LF_Thigh.STL"/>
    <mesh name="LF_Calf" file="LF_Calf.STL"/>
    <mesh name="RF_Thigh" file="RF_Thigh.STL"/>
    <mesh name="RF_Calf" file="RF_Calf.STL"/>
    <mesh name="LB_Thigh" file="LB_Thigh.STL"/>
    <mesh name="LB_Calf" file="LB_Calf.STL"/>
    <mesh name="RB_Thigh" file="RB_Thigh.STL"/>
    <mesh name="RB_Calf" file="RB_Calf.STL"/>
    <mesh name="LF_MAA_UPLink" file="LF_MAA_UPLink.STL"/>
    <mesh name="LF_MAA_FM_Link" file="LF_MAA_FM_Link.STL"/>
    <mesh name="LF_MAA_LOLink" file="LF_MAA_LOLink.STL"/>
    <mesh name="RF_MAA_UPLink" file="RF_MAA_UPLink.STL"/>
    <mesh name="RF_MAA_FM_Link" file="RF_MAA_FM_Link.STL"/>
    <mesh name="RF_MAA_LOLink" file="RF_MAA_LOLink.STL"/>
    <mesh name="LB_MAA_UPLink" file="LB_MAA_UPLink.STL"/>
    <mesh name="LB_MAA_FM_Link" file="LB_MAA_FM_Link.STL"/>
    <mesh name="LB_MAA_LOLink" file="LB_MAA_LOLink.STL"/>
    <mesh name="RB_MAA_UPLink" file="RB_MAA_UPLink.STL"/>
    <mesh name="RB_MAA_FM_Link" file="RB_MAA_FM_Link.STL"/>
    <mesh name="RB_MAA_LOLink" file="RB_MAA_LOLink.STL"/>
    <mesh name="LF_BAA_UPLink" file="LF_BAA_UPLink.STL"/>
    <mesh name="LF_BAA_FM_Link" file="LF_BAA_FM_Link.STL"/>
    <mesh name="LF_BAA_LOLink" file="LF_BAA_LOLink.STL"/>
    <mesh name="RF_BAA_UPLink" file="RF_BAA_UPLink.STL"/>
    <mesh name="RF_BAA_FM_Link" file="RF_BAA_FM_Link.STL"/>
    <mesh name="RF_BAA_LOLink" file="RF_BAA_LOLink.STL"/>
    <mesh name="LB_BAA_UPLink" file="LB_BAA_UPLink.STL"/>
    <mesh name="LB_BAA_FM_Link" file="LB_BAA_FM_Link.STL"/>
    <mesh name="LB_BAA_LOLink" file="LB_BAA_LOLink.STL"/>
    <mesh name="RB_BAA_UPLink" file="RB_BAA_UPLink.STL"/>
    <mesh name="RB_BAA_FM_LINK" file="RB_BAA_FM_LINK.STL"/>
    <mesh name="RB_BAA_LOLink" file="RB_BAA_LOLink.STL"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 5"/>
    <geom size="10 10 .01" type="plane" material="grid" friction="1 0.005 0.0001"/>


    <!-- horizontal base -->
    <!-- <body name="horizontal base" pos="-0.2 0 0">
      <geom type="box" size="0.01 1 0.01" rgba="0 1 0 0.4" mass="0.001"/> -->
  
    <!-- vertical base  -->

    <!-- <body name="vertical base" pos="0.1 0 1">
      <geom type="box" size="0.01 0.01 0.4" rgba="0 1 0 0.4" mass="0.001"/> -->
      <!-- <joint name="vertical base joint" type="slide" axis="0 1 0" damping="0" stiffness="0" springref="0"/> -->
      

    <body name="base" pos="0.1 0 1">
      <!-- <freejoint/> -->
      <!-- <joint name="base_joint" type="slide" axis="0 0 1" damping="10" stiffness="10000" springref="1"/> -->
      <geom type="mesh" rgba="0.75294 0.75294 0.75294 1" mesh="base_link" mass="0.155" />

      <body name="RB_Thigh" pos="0.1245 -0.235 -0.105">
        <joint name="RB_Shoulder" pos="0 0 0" axis="-1 0 0" range="-1.046 1.046" damping="0" stiffness="0" springref="0"/>
        <geom type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="RB_Thigh" mass="0.086" />
        
        <body name="RB_Calf" pos="0 0 -0.25">
          <joint name="RB_Elbow" pos="0 0 0" axis="-1 0 0" range="-1.57 0.628" damping="0" stiffness="0" springref="0"/>
          <geom type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="RB_Calf" mass="0.1033" friction="1 0.005 0.0001" />
        </body>

      </body>

      <body name="RB_MAA_UPLink" pos="0.125 -0.175 -0.105">
        <joint name="RB_MAA_UpJoint" pos="0 0 0" axis="-1 0 0" damping="0.01" stiffness="0" springref="0"/>
        <geom type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="RB_MAA_UPLink" mass="0.0001" />
        <geom type="sphere" size="0.01" rgba="1 0 0 1" mass="0.03091666667" />

        <body name="RB_MAA_FM_Link" pos="-0.01 -0.015 -0.105">
          <joint name="RB_MAA_SlideJoint" pos="0 0 0" axis="0 -0.141421 -0.989949" type="slide" damping="22" stiffness="740" springref="-0.019066"/>
          <geom type="mesh" rgba="1 0 0 1" mesh="RB_MAA_FM_Link" mass="0.001" />
          <geom type="sphere" size="0.01" rgba="1 0 0 1" mass="0.1236666667" />
          
          <body name="RB_MAA_LOLink" pos="0.01 -0.015 -0.105">
            <joint name="RB_MAA_FM_SlideJoint" pos="0 0 0" axis="0 -0.141421 -0.989949" type="slide" damping="22" stiffness="740" springref="-0.019066"/>
            <geom type="mesh" rgba="0.752941 0.752941 0.752941 1" mesh="RB_MAA_LOLink" mass="0.001" />
            <geom type="sphere" size="0.01" rgba="1 0 0 1" mass="0.03091666667" />
          </body>

        </body>

      </body>
      
      <body name="RB_BAA_UPLink" pos="0.125 -0.335 -0.105">
        <joint name="RB_BAA_UpJoint" pos="0 0 0" axis="1 0 0" damping="0" stiffness="0" springref="0"/>
        <geom type="mesh" rgba="1 1 1 1" mesh="RB_BAA_UPLink" mass="0.001" />
        <!-- <site name="RB_BAA_START" pos="0 0 0" size="0.01" rgba="1 0 0 1"/> -->
        <geom type="sphere" size="0.01" rgba="1 0 0 1" mass="0.04498333333" />
        
        <body name="RB_BAA_FM_LINK" pos="-0.01 0.00669873 -0.1">
          <joint name="RB_BAA_SlideJoint" pos="0 0 0" axis="0 0.0668375 -0.997764" type="slide" damping="22" stiffness="600" springref="0.02578"/>
          <geom type="mesh" rgba="1 0 0 1" mesh="RB_BAA_FM_LINK" mass="0.001" />
          <geom type="sphere" size="0.01" rgba="1 0 0 1" mass="0.1799333333" />
          
          <body name="RB_BAA_LOLink" pos="0.01 0.00669873 -0.1">
            <joint name="RB_BAA_FM_SlideJoint" pos="0 0 0" axis="0 0.0668375 -0.997764" type="slide" damping="22" stiffness="600" springref="0.02578"/>
            <geom type="mesh" rgba="0.75294 0.75294 0.75294 1" mesh="RB_BAA_LOLink" mass="0.001" />
            <site name="RB_BAA_END" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>
            <geom type="sphere" size="0.01" rgba="1 0 0 1" mass="0.04498333333" />
          </body>

        </body>

      </body>

    </body>


    
    <!-- <body name="base box" pos="0 0 0">
      <geom type="box" size="0.01 0.01 0.01" rgba="0 1 0 1"/> -->

      <!-- <body name="floating mass" pos="0 0 0.1">
        <geom type="box" size="0.01 0.01 0.01" rgba="1 0 0 1"/>
        <joint name="j1" type="slide" axis="0 0 1" damping="10" stiffness="1000" springref="0"/> -->

        <!-- <body name="end box" pos="0 0 0.4"> 
          <geom type="box" size="0.3 0.3 0.005" rgba="0 1 0 1" mass="10"/>
          <joint name="j2" type="slide" axis="0 0 1" damping="10" stiffness="1000" springref="0"/>
        </body> -->
      <!-- </body> -->
    <!-- </body> -->

  </worldbody>

  <!-- 增加在RB_BAA_LowerJoint等关节中加入8个位置控制器，要求增加位置限制 -->
  <actuator>
    <!-- <motor joint="RB_MAA_UpJoint" ctrllimited="true" ctrlrange="-300 300" /> -->
    <motor joint="RB_MAA_SlideJoint" ctrllimited="true" ctrlrange="-300 300" />
    <motor joint="RB_MAA_FM_SlideJoint" ctrllimited="true" ctrlrange="-300 300" />
    <motor joint="RB_BAA_SlideJoint" ctrllimited="true" ctrlrange="-300 300" />
    <motor joint="RB_BAA_FM_SlideJoint" ctrllimited="true" ctrlrange="-300 300" />
  </actuator>

  <!-- 建立并联关系，如 RB_BAA_LOLink 应该与 RB_Calf 连接 --> 
  <equality>
    <!-- <connect name="RB_MAA_LOLink" body1="RB_MAA_LOLink" body2="RB_Thigh" anchor="0 0 0" solref="0.001 1" solimp="0.999 0.9995 0.001"/>
    <connect name="RB_BAA_LOLink" body1="RB_BAA_LOLink" body2="RB_Calf" anchor="0 0 0" solref="0.001 1" solimp="0.999 0.9995 0.001"/> -->

    <!-- FM 的相等约束 -->
    <joint name="RB_MAA_FM" joint1="RB_MAA_SlideJoint" joint2="RB_MAA_FM_SlideJoint" solimp="0.95 0.99 0.00001"/>
    <joint name="RB_BAA_FM" joint1="RB_BAA_SlideJoint" joint2="RB_BAA_FM_SlideJoint" solimp="0.95 0.99 0.00001"/>
  </equality>

  <sensor>
    <!-- <jointpos name="RB_Shoulder" joint="RB_Shoulder"/>
    <jointpos name="RB_Elbow" joint="RB_Elbow"/> -->
    <!-- <jointpos name="RB_MAA_SlideJoint" joint="RB_MAA_SlideJoint"/> -->
    <!-- <jointpos name="RB_BAA_SlideJoint" joint="RB_BAA_SlideJoint"/> -->
    <!-- <jointpos name="RB_MAA_FM_SlideJoint" joint="RB_MAA_FM_SlideJoint"/> -->
    <!-- <jointpos name="RB_BAA_FM_SlideJoint" joint="RB_BAA_FM_SlideJoint"/> -->
  </sensor>

</mujoco>
