<!-- 单驱动器简化模型 -->

<mujoco model="v2_4">
  <compiler angle="radian"/>
  <option timestep="0.0005" iterations="1000"/>
  <!-- <option solver="PGS" timestep="0.001" /> -->
  
  <default>
    <geom density="418"/>
    <!-- <equality solimp="0.015 1 0.03" solref="0.005 1"/> -->
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3"
      rgb2=".2 .3 .4" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance=".2"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 5"/>
    <geom size="10 10 .01" type="plane" material="grid" friction="1 0.005 0.0001"/>
    <camera name="fixed" pos="0 -1.3 1.2" xyaxes="1 0 0 0 1 2"/>
    
    <body name="base" pos="0 0 1">
      <geom type="box" size="0.1 0.1 0.005" rgba="0 0 0.5 0.4" mass="0.03091666667"/>

        <body name="RB_MAA_FM_Link" pos="0 0 -0.5">
            <joint name="RB_MAA_SlideJoint" pos="0 0 0" axis="0 0 -1" type="slide" damping="22" stiffness="740" springref="0"/>
            <geom type="sphere" size="0.01" rgba="1 0 0 0.6" mass="0.1236666667"/>
            
            <body name="RB_MAA_LOLink" pos="0 0 -0.077">
                <joint name="RB_MAA_FM_SlideJoint" pos="0 0 0" axis="0 0 -1" type="slide" damping="22" stiffness="740" springref="0"/>
                <geom type="sphere" size="0.01" rgba="1 0 0 0.6" mass="0.3"/>
            </body>
        </body>
    </body>

  </worldbody>

  <!-- 增加在RB_BAA_LowerJoint等关节中加入8个位置控制器，要求增加位置限制 -->
  <actuator>
    <!-- <motor joint="RB_MAA_UpJoint" ctrllimited="true" ctrlrange="-300 300" /> -->
    <motor joint="RB_MAA_SlideJoint" ctrllimited="true" ctrlrange="-300 300" />
    <motor joint="RB_MAA_FM_SlideJoint" ctrllimited="true" ctrlrange="-300 300" />
  </actuator>

  <!-- 建立并联关系，如 RB_BAA_LOLink 应该与 RB_Calf 连接 --> 
  <equality>
    <!-- FM 的相等约束 -->
    <joint name="RB_MAA_FM" joint1="RB_MAA_SlideJoint" joint2="RB_MAA_FM_SlideJoint" solimp="0.995 0.999 0.00001"/>
  </equality>

  <sensor>
  </sensor>

</mujoco>
