     rgb2=".2 .3 .4" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance=".2"/>

    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="LF_Thigh" file="LF_Thigh.STL"/>
    <mesh name="LF_Calf" file="LF_Calf.STL"/>
