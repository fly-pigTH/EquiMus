          <joint name="RB_Elbow2" pos="0 0 0" axis="1 0 0" range="-3.14 3.14" actuatorfrcrange="-10 10"/>
          <geom type="mesh" rgba="0.75294 0.75294 0.75294 1" mesh="RB_Calf"/>
        </body> -->
